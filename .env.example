# Optional MiniMax/OpenAI-compatible provider. Do not expose this key in frontend code.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
AI_COMMITTEE_USE_LLM=true
AI_COMMITTEE_LLM_AGENT_MAX_TOKENS=8000
AI_COMMITTEE_LLM_REPAIR_MAX_TOKENS=6000
AI_COMMITTEE_LLM_JSON_RETRY_MAX_TOKENS=9000

# Keep false for真实投委会。只有本地离线调试时才可设为 true。
AI_COMMITTEE_ALLOW_FALLBACK=false

# 实时证券报价。A 股、港股、美股按独立证券代码刷新，避免多地上市公司串价。
AI_COMMITTEE_LIVE_QUOTES=true
AI_COMMITTEE_QUOTE_MAX_AGE_SECONDS=300

# 数据采集兜底。官方/交易所源失败后，允许用搜索引擎发现并保存可回溯原文。
AI_COMMITTEE_ENABLE_SEARCH_FALLBACK=true
AI_COMMITTEE_MAX_SEARCH_RESULTS=5
AI_COMMITTEE_MAX_SEARCH_DOCUMENTS=3

# 专家库联网补强。后台会搜索传记、访谈、股东信、演讲、对话等公开材料，并交给 LLM 蒸馏成专家画像。
AI_COMMITTEE_EXPERT_WEB_MAX_SOURCES=4
AI_COMMITTEE_EXPERT_WEB_SOURCE_CHARS=12000
AI_COMMITTEE_EXPERT_DISTILL_MAX_TOKENS=7000

# Local persistence/output paths
APP_DB_PATH=data/ai_committee.sqlite
REPORT_OUTPUT_DIR=output/reports

# Production access control. Set both values before exposing the app publicly.
APP_BASIC_AUTH_ENABLED=false
APP_BASIC_AUTH_USERNAME=
APP_BASIC_AUTH_PASSWORD=
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
